{
  "manifest_version": 3,
  "name": "YouTube™ Availability Refresher",
  "author": "Thor110",
  "update_url": "https://github.com/Thor110/ChromeExtensions",
  "version": "1.0.2",
  "description": "Refreshes availability on YouTube™.",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/watch*"],
      "js": ["refresh.js"]
    }
  ]
}